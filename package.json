{
  "name": "desktop-pet-console",
  "productName": "桌宠",
  "description": "本地优先、支持动态角色包的 Windows 桌面伙伴",
  "author": "Desktop Pet Team",
  "private": true,
  "version": "0.2.2",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/followTheWind223/xiaoyi-desktop-pet.git"
  },
  "homepage": "https://github.com/followTheWind223/xiaoyi-desktop-pet#readme",
  "bugs": {
    "url": "https://github.com/followTheWind223/xiaoyi-desktop-pet/issues"
  },
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "desktop": "npm run build && electron .",
    "desktop:open": "electron .",
    "pack:win": "npm run build && electron-builder --win --x64 --dir --config.electronDist=node_modules/electron/dist",
    "dist:win": "npm run build && electron-builder --win --x64 --config.electronDist=node_modules/electron/dist",
    "smoke:characters": "node scripts/character-scanner-smoke.mjs",
    "smoke:desktop": "node scripts/electron-smoke.mjs",
    "smoke:packaged": "node scripts/packaged-smoke.mjs",
    "smoke:settings": "node scripts/settings-persistence-smoke.mjs",
    "smoke:settings:packaged": "node scripts/settings-persistence-smoke.mjs --packaged",
    "smoke:ui": "node scripts/ui-smoke.mjs"
  },
  "dependencies": {
    "@lucide/vue": "^1.39.0",
    "pinia": "^3.0.3",
    "vue": "^3.5.21"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.1",
    "electron": "^44.1.1",
    "electron-builder": "^26.15.3",
    "typescript": "~5.8.3",
    "vite": "^7.1.3",
    "vue-tsc": "^3.0.6"
  },
  "build": {
    "appId": "xin.yimian.desktop-pet-console",
    "productName": "桌宠",
    "asar": true,
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/characters",
        "to": "characters",
        "filter": [
          "**/*",
          "!README.md",
          "!.gitkeep"
        ]
      },
      {
        "from": "build/app-icon.png",
        "to": "app-icon.png"
      }
    ],
    "win": {
      "icon": "build/app-icon.ico",
      "requestedExecutionLevel": "asInvoker",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "artifactName": "${productName}-Setup-${version}-${arch}.${ext}",
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "perMachine": false,
    "selectPerMachineByDefault": false,
    "createDesktopShortcut": "always",
    "createStartMenuShortcut": true,
    "shortcutName": "桌宠",
    "runAfterFinish": true,
    "deleteAppDataOnUninstall": false,
    "uninstallDisplayName": "桌宠",
      "installerIcon": "build/app-icon.ico",
      "uninstallerIcon": "build/app-icon.ico"
    },
    "portable": {
      "artifactName": "${productName}-Portable-${version}-${arch}.${ext}"
    }
  }
}
