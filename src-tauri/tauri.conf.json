{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "桌宠控制台",
  "version": "0.1.0",
  "identifier": "xin.yimian.desktop-pet-console",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "console",
        "title": "桌宠控制台",
        "width": 1180,
        "height": 760,
        "minWidth": 960,
        "minHeight": 640,
        "center": true,
        "resizable": true,
        "maximized": false,
        "fullscreen": false,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "shortDescription": "Agent 桌面宠物本地控制台",
    "longDescription": "管理桌宠、OpenAI 兼容模型、本地语音与桌面行为。"
  }
}
